{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/reference-set.schema.json",
  "title": "Auto3Dvideo Reference Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "referenceSetId", "projectId", "name", "scope", "status", "continuityNote", "assignments", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "referenceSetId": {"type": "string", "minLength": 4, "maxLength": 120},
    "projectId": {"type": "string", "minLength": 4, "maxLength": 120},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "scope": {"enum": ["sequence", "character", "object", "world", "shot"]},
    "status": {"enum": ["active", "archived"]},
    "continuityNote": {"type": "string", "maxLength": 4000},
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assignmentId", "assetId", "role", "strength", "priority", "approved", "assetSha256", "createdAt", "updatedAt"],
        "properties": {
          "assignmentId": {"type": "string", "minLength": 4, "maxLength": 120},
          "assetId": {"type": "string", "minLength": 4, "maxLength": 120},
          "role": {"enum": ["identity", "composition", "pose", "camera", "style", "start_frame", "end_frame", "negative"]},
          "strength": {"type": "number", "minimum": 0, "maximum": 1},
          "priority": {"type": "integer", "minimum": 0},
          "shotId": {"type": ["string", "null"], "maxLength": 120},
          "shotRangeStart": {"type": ["integer", "null"], "minimum": 0},
          "shotRangeEnd": {"type": ["integer", "null"], "minimum": 0},
          "crop": {"type": ["string", "null"], "maxLength": 120},
          "notes": {"type": "string", "maxLength": 2000},
          "approved": {"type": "boolean"},
          "assetSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "createdAt": {"type": "string"},
          "updatedAt": {"type": "string"}
        }
      }
    },
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"},
    "archivedAt": {"type": ["string", "null"]}
  }
}
