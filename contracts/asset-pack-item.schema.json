{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/asset-pack-item.schema.json",
  "title": "Auto3Dvideo Asset Pack Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetItemId",
    "packId",
    "title",
    "role",
    "prompt",
    "negativePrompt",
    "referenceAssetIds",
    "shotIds",
    "requiredViews",
    "width",
    "height",
    "provider",
    "status",
    "reviewState",
    "rightsStatus",
    "acceptanceChecks",
    "generationAttempts",
    "outputAssetIds"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "assetItemId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "packId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "identityAnchorId": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "role": {
      "type": "string",
      "enum": ["identity", "composition", "pose", "camera", "style", "environment", "prop", "scale_reference", "start_frame", "end_frame"]
    },
    "prompt": {"type": "string", "minLength": 20, "maxLength": 12000},
    "negativePrompt": {"type": "string", "minLength": 10, "maxLength": 8000},
    "promptVersion": {"type": "string", "maxLength": 80},
    "referenceAssetIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}
    },
    "shotIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"}
    },
    "requiredViews": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 16,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"}
    },
    "width": {"type": "integer", "minimum": 256, "maximum": 8192},
    "height": {"type": "integer", "minimum": 256, "maximum": 8192},
    "scaleMeters": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000},
    "continuityAnchors": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {"type": "string", "enum": ["nano_banana_mcp", "comfyui", "local_image", "manual"]},
        "model": {"type": ["string", "null"], "maxLength": 160},
        "transport": {"type": ["string", "null"], "enum": ["cdp", "http", "local", "manual", null]}
      }
    },
    "status": {
      "type": "string",
      "enum": ["planned", "validated", "queued", "generating", "ingested", "needs_review", "approved", "blocked", "failed", "rejected"]
    },
    "reviewState": {"type": "string", "enum": ["not_started", "in_review", "approved", "rejected", "needs_revision"]},
    "rightsStatus": {"type": "string", "enum": ["unknown", "pending", "personal", "owned", "licensed", "public_domain", "restricted", "rejected"]},
    "acceptanceChecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "description", "required", "status"],
        "properties": {
          "checkId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "required": {"type": "boolean"},
          "status": {"type": "string", "enum": ["pending", "pass", "fail", "not_applicable"]},
          "evidence": {"type": ["string", "null"], "maxLength": 1000}
        }
      }
    },
    "generationAttempts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "provider", "promptHash", "status", "createdAt"],
        "properties": {
          "attempt": {"type": "integer", "minimum": 1, "maximum": 8},
          "provider": {"type": "string", "minLength": 1, "maxLength": 160},
          "promptHash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "status": {"type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled"]},
          "failureCode": {"type": ["string", "null"], "maxLength": 120},
          "retryReason": {"type": ["string", "null"], "maxLength": 500},
          "createdAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "outputAssetIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}
    },
    "note": {"type": "string", "maxLength": 4000}
  }
}
