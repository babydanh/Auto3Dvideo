{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/character-bible.schema.json",
  "title": "Auto3Dvideo Character Bible",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "characterId", "name", "species", "heightMeters", "identityAnchors", "motionConstraints", "prohibitedChanges"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "characterId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,96}$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 160},
    "species": {"type": "string", "minLength": 2, "maxLength": 160},
    "heightMeters": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
    "identityAnchors": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 600}, "maxItems": 32},
    "silhouette": {"type": "string", "maxLength": 1000},
    "colors": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 24},
    "materials": {"type": "array", "items": {"type": "string", "maxLength": 160}, "maxItems": 24},
    "props": {"type": "array", "items": {"type": "string", "maxLength": 160}, "maxItems": 24},
    "rigRequirements": {"type": "array", "items": {"type": "string", "maxLength": 400}, "maxItems": 24},
    "motionConstraints": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 600}, "maxItems": 32},
    "prohibitedChanges": {"type": "array", "items": {"type": "string", "maxLength": 600}, "maxItems": 32},
    "referenceAssetIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 64}
  }
}
