{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/google-flow-video-action.schema.json",
  "title": "Auto3Dvideo Google Flow video action request and report",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/report" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectUrl",
        "mode",
        "prompt",
        "shotId",
        "revisionId",
        "runId",
        "model",
        "expectedCreditCost",
        "approvedBatchCreditCap",
        "shotCount",
        "userApproved"
      ],
      "properties": {
        "projectUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://flow\\.google\\.com/project/[A-Za-z0-9-]+(?:[/?#].*)?$"
        },
        "mode": { "enum": ["type_prompt", "click_generate"] },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "description": "Shot prompt containing the exact SHOT_ID and REVISION_ID fields."
        },
        "shotId": { "type": "string", "pattern": "^SHOT-[0-9]{3}$" },
        "revisionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$" },
        "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
        "model": { "const": "Omni 1.1 Flash" },
        "expectedCreditCost": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "approvedBatchCreditCap": { "type": "integer", "minimum": 1, "maximum": 119988 },
        "userApproved": { "const": true },
        "referenceMediaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?:__newest__|[A-Za-z0-9][A-Za-z0-9_.:-]{2,255})$",
          "description": "The exact Flow media ID the human confirmed for this shot. The worker re-reads the ingredient chip against it immediately before the prompt and again immediately before Generate. Absent for a legacy text-only shot with no binding."
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "message", "promptAccepted", "generateClicked", "reportPath"],
      "properties": {
        "status": { "enum": ["ready", "blocked"] },
        "referenceVerified": {
          "type": ["boolean", "null"],
          "description": "The worker's fresh ingredient-chip read taken immediately before this action: true when the confirmed media was still attached, false when the chip drifted, null for a legacy shot with no binding."
        },
        "message": { "type": "string", "minLength": 1 },
        "promptAccepted": { "type": "boolean" },
        "generateClicked": { "type": "boolean" },
        "reportPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
