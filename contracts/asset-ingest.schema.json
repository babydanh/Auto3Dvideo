{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/asset-ingest.schema.json",
  "title": "Auto3Dvideo Asset Ingest Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobType", "projectId", "runId", "assets"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "jobType": {"type": "string", "const": "asset.ingest"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "title", "sourcePath", "declaredKind", "role", "rightsStatus", "reviewState", "shotIds", "provenance"],
        "properties": {
          "assetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "sourcePath": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
          "declaredKind": {"type": "string", "enum": ["reference_image", "model3d", "texture", "render"]},
          "role": {"type": "string", "enum": ["identity", "composition", "pose", "camera", "style", "texture", "start_frame", "end_frame", "environment", "model3d"]},
          "rightsStatus": {"type": "string", "enum": ["unknown", "pending", "personal", "owned", "licensed", "public_domain", "restricted", "rejected"]},
          "reviewState": {"type": "string", "enum": ["draft", "needs_review", "approved", "rejected", "blocked"]},
          "shotIds": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"}},
          "provenance": {"type": "string", "minLength": 1, "maxLength": 2000},
          "sourceUri": {"type": ["string", "null"], "maxLength": 2000},
          "tags": {"type": "array", "maxItems": 24, "items": {"type": "string", "maxLength": 64}},
          "note": {"type": "string", "maxLength": 4000}
        }
      }
    }
  }
}
