{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/video-script.schema.json",
  "title": "Auto3Dvideo Local Video Script",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scriptId", "briefId", "language", "title", "hook", "segments", "approvalStatus"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "scriptId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "briefId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 160},
    "hook": {"type": "string", "minLength": 3, "maxLength": 500},
    "sourcePrompt": {"type": "string", "maxLength": 4000},
    "promptGrounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sourcePrompt", "worldBible", "characterBibles", "constraints", "subjectSummary"],
      "properties": {
        "schemaVersion": {"type": "string", "const": "1.0.0"},
        "sourcePrompt": {"type": "string", "maxLength": 4000},
        "worldBible": {"type": "object", "additionalProperties": true},
        "characterBibles": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": true}},
        "constraints": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1000}},
        "subjectSummary": {"type": "string", "maxLength": 2000}
      }
    },
    "segments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segmentId", "narration", "onScreenText", "durationSeconds", "claimStatus"],
        "properties": {
          "teachingScene": {"$ref": "coding-lesson.schema.json#/$defs/teachingScene"},
          "segmentId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "assetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
          "narration": {"type": "string", "minLength": 3, "maxLength": 1200},
          "onScreenText": {"type": "string", "maxLength": 180},
          "durationSeconds": {"type": "number", "minimum": 1, "maximum": 30},
          "claimStatus": {"type": "string", "enum": ["needs_review", "verified", "user_provided", "not_applicable"]},
          "sourceNote": {"type": ["string", "null"], "maxLength": 500},
          "voiceCue": {"type": "string", "enum": ["none", "laugh", "sigh", "clear_throat"]},
          "emotionCode": {"type": "string", "enum": ["neutral", "calm", "warm", "friendly", "happy", "excited", "joyful", "triumphant", "sad", "melancholic", "tender", "concerned", "fearful", "angry", "shouting", "urgent", "serious", "surprised", "mysterious", "curious", "sarcastic", "whisper"]},
          "visualPrompt": {"type": "string", "maxLength": 4000},
          "subject": {"type": "string", "maxLength": 1000},
          "action": {"type": "string", "maxLength": 1000},
          "cameraIntent": {"type": "string", "maxLength": 1000},
          "lightingIntent": {"type": "string", "maxLength": 1000},
          "continuityNotes": {"type": "string", "maxLength": 2000},
          "negativePrompt": {"type": "string", "maxLength": 2000},
          "sceneMode": {"type": "string", "maxLength": 64},
          "revisionId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
          "revisionPrompt": {"type": "string", "maxLength": 1600},
          "revisionImagePath": {"type": ["string", "null"], "pattern": "^(?!.*(?:^|/)(?:\\.\\.?)(?:/|$))[A-Za-z0-9_./\\-]+\\.(?:png|jpg|jpeg|webp)$", "maxLength": 260},
          "dirty": {"type": "boolean"},
          "beats": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["beatId", "timeFraction", "purpose", "action", "cameraPrompt", "imageRole", "prompt"],
              "properties": {
                "beatId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
                "timeFraction": {"type": "number", "minimum": 0, "maximum": 1},
                "purpose": {"type": "string", "minLength": 3, "maxLength": 500},
                "action": {"type": "string", "minLength": 3, "maxLength": 1000},
                "cameraPrompt": {"type": "string", "minLength": 3, "maxLength": 1000},
                "imageRole": {"type": "string", "enum": ["establish", "action", "reveal", "resolve"]},
                "prompt": {"type": "string", "minLength": 3, "maxLength": 3000}
              }
            }
          }
        }
      }
    },
    "totalDurationSeconds": {"type": "number", "minimum": 2, "maximum": 180},
    "requestedShotCount": {"type": "integer", "minimum": 2, "maximum": 12},
    "requestedDurationSeconds": {"type": "number", "minimum": 2, "maximum": 180},
    "sourcePromptHash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "promptVersion": {"type": "string", "maxLength": 120},
    "sceneMode": {"type": "string", "maxLength": 64},
    "approvalStatus": {"type": "string", "enum": ["pending", "approved", "rejected"]},
    "visualMode": {"type": "string", "enum": ["space-25d", "licensed-footage-space", "cinematic-3d", "coding-25d"]},
    "audioMode": {"type": "string", "enum": ["narrated", "caption-only"]},
    "codingLesson": {"$ref": "coding-lesson.schema.json#/$defs/lesson"},
    "footageManifestPath": {"type": "string", "pattern": "^(?!.*(?:^|/)(?:\\.\\.?)(?:/|$))[A-Za-z0-9_./\\-]+\\.json$", "maxLength": 260},
    "voiceSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presetVoice": {"type": "string", "minLength": 1, "maxLength": 128},
        "temperature": {"type": "number", "minimum": 0.6, "maximum": 1.2},
        "voiceCueBySegment": {
          "type": "object",
          "additionalProperties": {"type": "string", "enum": ["none", "laugh", "sigh", "clear_throat"]}
        },
        "emotionCodeBySegment": {
          "type": "object",
          "additionalProperties": {"type": "string", "enum": ["neutral", "calm", "warm", "friendly", "happy", "excited", "joyful", "triumphant", "sad", "melancholic", "tender", "concerned", "fearful", "angry", "shouting", "urgent", "serious", "surprised", "mysterious", "curious", "sarcastic", "whisper"]}
        },
        "cloneEnabled": {"type": "boolean"},
        "cloneConsent": {"type": "boolean"},
        "referenceAudioPath": {"type": "string", "pattern": "^(?!.*(?:^|/)(?:\\.\\.?)(?:/|$))[A-Za-z0-9_./\\-]+\\.(?:wav|mp3|flac|m4a|ogg)$", "maxLength": 260},
        "voiceProfileId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
        "mode": {"type": "string", "enum": ["clone", "design"]},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$", "maxLength": 16},
        "instruct": {"type": "string", "maxLength": 1000},
        "speed": {"type": "number", "minimum": 0.5, "maximum": 2.0},
        "qualityPreset": {"type": "string", "enum": ["preview", "balanced", "quality"]}
      }
    },
    "generatedAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"visualMode": {"const": "coding-25d"}}, "required": ["visualMode"]},
      "then": {
        "required": ["codingLesson", "totalDurationSeconds"],
        "properties": {
          "segments": {
            "minItems": 2,
            "maxItems": 12,
            "items": {"required": ["teachingScene"], "properties": {"durationSeconds": {"maximum": 30}}}
          },
          "totalDurationSeconds": {"maximum": 180}
        }
      },
      "else": {
        "not": {"required": ["codingLesson"]},
        "properties": {"segments": {"items": {"not": {"required": ["teachingScene"]}}}}
      }
    }
  ]
}
