{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/timeline.schema.json",
  "title": "Auto3Dvideo Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "timelineId", "episodeId", "frameRate", "tracks", "version"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "timelineId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "episodeId": {"type": "string"},
    "frameRate": {"type": "number", "exclusiveMinimum": 0, "maximum": 240},
    "version": {"type": "integer", "minimum": 1},
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trackId", "kind", "clips"],
        "properties": {
          "trackId": {"type": "string"},
          "kind": {"type": "string", "enum": ["video", "audio", "caption", "marker"]},
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clipId", "assetId", "timelineStartFrame", "durationFrames"],
              "properties": {
                "clipId": {"type": "string"},
                "assetId": {"type": "string"},
                "timelineStartFrame": {"type": "integer", "minimum": 0},
                "sourceStartFrame": {"type": "integer", "minimum": 0},
                "durationFrames": {"type": "integer", "minimum": 1},
                "speed": {"type": "number", "exclusiveMinimum": 0},
                "label": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
