{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/video-workflow-session.schema.json",
  "title": "Auto3Dvideo local video workflow session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "projectId",
    "name",
    "topic",
    "title",
    "status",
    "lastStep",
    "updatedAt",
    "referenceAssetPaths",
    "geminiAssetPaths"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "sessionId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "projectId": {"type": "string", "minLength": 1},
    "sessionDirectory": {"type": "string", "pattern": "^outputs/sessions/[a-z0-9][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "topic": {"type": "string", "minLength": 1, "maxLength": 4000},
    "title": {"type": "string", "maxLength": 240},
    "durationSeconds": {"type": ["number", "null"], "minimum": 0, "maximum": 86400},
    "status": {"type": "string", "enum": ["draft", "storyboard_ready", "preview_ready", "gemini_ready", "comfyui_ready", "handoff_ready"]},
    "lastStep": {"type": "string", "minLength": 1, "maxLength": 80},
    "updatedAt": {"type": "string", "minLength": 1},
    "script": {"type": ["object", "null"]},
    "referenceAssetPaths": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1}},
    "geminiAssetPaths": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1}},
    "comfyuiAssetPaths": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "blenderPreview": {"type": ["object", "null"]}
  }
}
