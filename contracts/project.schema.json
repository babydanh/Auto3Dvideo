{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/project.schema.json",
  "title": "Auto3Dvideo Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "name", "workspace", "defaultProfile", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "workspace": {"type": "string", "minLength": 1},
    "defaultProfile": {"type": "string", "enum": ["mock", "local", "hybrid", "cloud"]},
    "defaultLanguage": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"},
    "frameRate": {"type": "number", "exclusiveMinimum": 0, "maximum": 240},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "archivedAt": {"type": ["string", "null"], "format": "date-time"},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {"type": "string", "enum": ["system", "light", "dark"]},
        "maxGpuJobs": {"type": "integer", "minimum": 0, "maximum": 8},
        "monthlyBudgetUsd": {"type": "number", "minimum": 0},
        "allowCloudGeneration": {"type": "boolean"},
        "allowExternalPublish": {"type": "boolean"}
      }
    }
  }
}
