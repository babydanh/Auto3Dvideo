{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/reference-video-intake.schema.json",
  "title": "Auto3Dvideo Reference Video Intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "intakeId", "episodeId", "input", "rightsGate", "analysis", "outputs", "reviewState"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "intakeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "episodeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "relativePathOrUrl", "mediaKind", "sha256"],
      "properties": {
        "sourceType": {"type": "string", "enum": ["local_file", "user_owned_upload", "authorized_url", "screen_recording", "browser_snapshot"]},
        "relativePathOrUrl": {"type": "string", "minLength": 1, "maxLength": 2048},
        "mediaKind": {"type": "string", "enum": ["video", "screen_recording"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "durationSeconds": {"type": ["number", "null"], "minimum": 0, "maximum": 604800},
        "width": {"type": ["integer", "null"], "minimum": 16, "maximum": 16384},
        "height": {"type": ["integer", "null"], "minimum": 16, "maximum": 16384},
        "frameRate": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 240}
      }
    },
    "rightsGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["useMode", "ownerOrProvider", "analysisAllowed", "downloadForReuse", "derivativeUse", "voiceReuse", "humanReviewRequired"],
      "properties": {
        "useMode": {"type": "string", "enum": ["analysis_only_moodboard", "user_owned", "licensed_asset_candidate"]},
        "ownerOrProvider": {"type": "string", "minLength": 1, "maxLength": 300},
        "permissionEvidencePath": {"type": ["string", "null"], "maxLength": 1024},
        "analysisAllowed": {"type": "boolean", "const": true},
        "downloadForReuse": {"type": "boolean"},
        "derivativeUse": {"type": "boolean"},
        "voiceReuse": {"type": "boolean", "const": false},
        "humanReviewRequired": {"type": "boolean", "const": true}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shotDetection", "keyframeSamplingFps", "audioTranscription", "visionPass", "extractAudio", "extractFramesOnly"],
      "properties": {
        "shotDetection": {"type": "string", "enum": ["histogram_cut", "content_change", "manual_markers", "hybrid"]},
        "sceneThreshold": {"type": "number", "minimum": 0, "maximum": 1},
        "keyframeSamplingFps": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "audioTranscription": {"type": "boolean"},
        "visionPass": {"type": "boolean", "const": true},
        "extractAudio": {"type": "boolean"},
        "extractFramesOnly": {"type": "boolean", "const": true},
        "analysisPromptVersion": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shotManifestPath", "evidenceDirectory", "transcriptPath", "contactSheetPath"],
      "properties": {
        "shotManifestPath": {"type": "string", "minLength": 1, "maxLength": 1024},
        "evidenceDirectory": {"type": "string", "minLength": 1, "maxLength": 1024},
        "transcriptPath": {"type": ["string", "null"], "maxLength": 1024},
        "contactSheetPath": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "reviewState": {"type": "string", "enum": ["draft", "needs_review", "approved", "rejected"]}
  }
}
