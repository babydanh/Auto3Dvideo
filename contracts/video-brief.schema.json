{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/video-brief.schema.json",
  "title": "Auto3Dvideo Local Video Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "briefId", "projectId", "topic", "profileId", "language", "objective", "durationSeconds", "aspectRatio", "width", "height", "frameRate", "approvalStatus"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "briefId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "topic": {"type": "string", "minLength": 3, "maxLength": 4000},
    "profileId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "promptTemplateId": {"type": ["string", "null"], "maxLength": 120},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"},
    "objective": {"type": "string", "minLength": 3, "maxLength": 2000},
    "audience": {"type": "string", "maxLength": 1000},
    "durationSeconds": {"type": "integer", "minimum": 10, "maximum": 180},
    "aspectRatio": {"type": "string", "enum": ["16:9", "9:16", "1:1", "4:5"]},
    "width": {"type": "integer", "minimum": 320, "maximum": 3840},
    "height": {"type": "integer", "minimum": 320, "maximum": 3840},
    "frameRate": {"type": "number", "enum": [24, 25, 30, 50, 60]},
    "visualMode": {"type": "string", "enum": ["svg_infographic", "html_motion", "slideshow", "voiceover_package"]},
    "approvalStatus": {"type": "string", "enum": ["pending", "approved", "rejected"]},
    "rightsStatus": {"type": "string", "enum": ["not_applicable", "pending", "approved", "rejected"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
