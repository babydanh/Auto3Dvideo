{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/episode.schema.json",
  "title": "Auto3Dvideo Episode",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "episodeId", "projectId", "title", "status", "language", "aspectRatio", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "episodeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"type": "string", "enum": ["draft", "in_production", "review", "approved", "delivered", "blocked"]},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"},
    "aspectRatio": {"type": "string", "enum": ["16:9", "9:16", "1:1", "4:5", "custom"]},
    "width": {"type": "integer", "minimum": 16, "maximum": 16384},
    "height": {"type": "integer", "minimum": 16, "maximum": 16384},
    "durationSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
    "frameRate": {"type": "number", "exclusiveMinimum": 0, "maximum": 240},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
