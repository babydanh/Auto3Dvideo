{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/asset-generation-report.schema.json",
  "title": "Auto3Dvideo Asset Generation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "jobType", "projectId", "packId", "runId", "status", "itemCounts", "items", "errors", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "reportId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "jobType": {"type": "string", "const": "asset.pack.generate"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "packId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "status": {"type": "string", "enum": ["succeeded_needs_review", "blocked", "failed"]},
    "itemCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "succeeded", "failed", "blocked", "needsReview"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "needsReview": {"type": "integer", "minimum": 0}
      }
    },
    "items": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetItemId", "status", "requestHash", "provider", "attempts", "outputs", "rightsStatus", "reviewState"],
        "properties": {
          "assetItemId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
          "status": {"type": "string", "enum": ["succeeded", "failed", "blocked", "needs_review"]},
          "requestHash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter"],
            "properties": {
              "adapter": {"type": "string", "minLength": 1, "maxLength": 160},
              "serverVersion": {"type": ["string", "null"], "maxLength": 160},
              "targetModel": {"type": ["string", "null"], "maxLength": 160}
            }
          },
          "attempts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attempt", "status", "retryable"],
              "properties": {
                "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
                "status": {"type": "string", "enum": ["running", "succeeded", "failed", "blocked"]},
                "retryable": {"type": "boolean"},
                "failureCode": {"type": ["string", "null"], "maxLength": 120},
                "message": {"type": ["string", "null"], "maxLength": 1000}
              }
            }
          },
          "outputs": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["assetId", "relativePath", "sha256", "width", "height", "status"],
              "properties": {
                "assetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
                "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.).+"},
                "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
                "width": {"type": "integer", "minimum": 1},
                "height": {"type": "integer", "minimum": 1},
                "status": {"type": "string", "enum": ["staged", "ingested", "quarantined"]},
                "providerJobId": {"type": ["string", "null"], "maxLength": 200},
                "error": {"type": ["string", "null"], "maxLength": 1000}
              }
            }
          },
          "rightsStatus": {"type": "string", "enum": ["unknown", "pending", "personal", "owned", "licensed", "public_domain", "restricted", "rejected"]},
          "reviewState": {"type": "string", "enum": ["not_started", "in_review", "approved", "rejected", "needs_revision"]},
          "costObservation": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "mode": {"type": "string", "enum": ["free", "credits", "usd", "unknown"]},
              "creditsUsed": {"type": ["number", "null"], "minimum": 0},
              "amountUsd": {"type": ["number", "null"], "minimum": 0},
              "note": {"type": ["string", "null"], "maxLength": 500}
            }
          },
          "failureCode": {"type": ["string", "null"], "maxLength": 120},
          "message": {"type": ["string", "null"], "maxLength": 1000}
        }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z0-9_]{3,80}$"},
          "message": {"type": "string", "minLength": 1, "maxLength": 1000},
          "retryable": {"type": "boolean"},
          "assetItemId": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"}
        }
      }
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
