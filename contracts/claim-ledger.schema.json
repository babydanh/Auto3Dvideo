{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/claim-ledger.schema.json",
  "title": "Auto3Dvideo Claim Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ledgerId", "episodeId", "language", "claims", "reviewState"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "ledgerId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "episodeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "statement", "claimType", "sources", "evidenceNote", "confidence", "reviewState", "humanReviewRequired"],
        "properties": {
          "claimId": {"type": "string", "pattern": "^claim-[0-9]{3}$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "claimType": {"type": "string", "enum": ["fact", "definition", "number", "comparison", "inference", "creative"]},
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "format": "uri", "maxLength": 2048}
          },
          "evidenceNote": {"type": "string", "minLength": 1, "maxLength": 4000},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "caveat": {"type": ["string", "null"], "maxLength": 2000},
          "reviewState": {"type": "string", "enum": ["draft", "needs_review", "approved", "rejected"]},
          "reviewer": {"type": ["string", "null"], "maxLength": 200},
          "humanReviewRequired": {"type": "boolean", "const": true}
        }
      }
    },
    "reviewState": {"type": "string", "enum": ["draft", "needs_review", "approved", "rejected"]}
  }
}
