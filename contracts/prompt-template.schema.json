{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/prompt-template.schema.json",
  "title": "Auto3Dvideo Prompt Template Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templates"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["templateId", "version", "name", "purpose", "locale", "body", "inputKeys", "outputContract", "guardrails"],
        "properties": {
          "templateId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "name": { "type": "string", "minLength": 2, "maxLength": 120 },
          "purpose": { "type": "string", "minLength": 10, "maxLength": 300 },
          "locale": { "enum": ["vi-VN", "en-US", "multi"] },
          "body": { "type": "string", "minLength": 50, "maxLength": 8000 },
          "inputKeys": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{1,63}$" } },
          "outputContract": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2, "maxLength": 120 } },
          "guardrails": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 5, "maxLength": 300 } }
        }
      }
    }
  }
}
