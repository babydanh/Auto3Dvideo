{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/shot.schema.json",
  "title": "Auto3Dvideo Shot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "shotId", "episodeId", "order", "status", "durationFrames", "promptVersion", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "shotId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "episodeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "order": {"type": "integer", "minimum": 0},
    "status": {"type": "string", "enum": ["planned", "ready", "queued", "generating", "generated", "needs_review", "approved", "rejected", "blocked", "archived"]},
    "durationFrames": {"type": "integer", "minimum": 1, "maximum": 864000},
    "promptVersion": {"type": "string", "minLength": 1, "maxLength": 120},
    "negativePrompt": {"type": ["string", "null"], "maxLength": 10000},
    "aspectRatio": {"type": "string", "enum": ["16:9", "9:16", "1:1", "4:5", "custom"]},
    "width": {"type": "integer", "minimum": 16, "maximum": 16384},
    "height": {"type": "integer", "minimum": 16, "maximum": 16384},
    "frameRate": {"type": "number", "exclusiveMinimum": 0, "maximum": 240},
    "referenceAssetIds": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}, "uniqueItems": true},
    "generationJobId": {"type": ["string", "null"]},
    "outputAssetIds": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}, "uniqueItems": true},
    "reviewState": {"type": "string", "enum": ["not_started", "in_review", "approved", "rejected", "needs_revision"]},
    "notes": {"type": "string", "maxLength": 5000},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
