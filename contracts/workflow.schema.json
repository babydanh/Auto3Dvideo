{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/workflow.schema.json",
  "title": "Auto3Dvideo Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowId", "name", "profile", "stages", "policy"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "workflowId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "profile": {"type": "string", "enum": ["mock", "local", "hybrid", "cloud"]},
    "inputs": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "modelProfiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "providerDefaults": {"type": "object", "additionalProperties": {"type": "string"}},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dryRunDefault": {"type": "boolean"},
        "paidGenerationRequiresApproval": {"type": "boolean"},
        "externalPublish": {"type": "boolean"},
        "maxRetriesPerShot": {"type": "integer", "minimum": 0, "maximum": 10},
        "maxGpuJobs": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "outputs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
          "type": {"type": "string", "minLength": 1},
          "dependsOn": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "resource": {"type": "string", "enum": ["cpu", "cpu_heavy", "gpu", "io_heavy", "network", "paid_api", "interactive"]},
          "executor": {"type": "string", "enum": ["mock", "comfyui", "blender", "ffmpeg", "provider_adapter", "interactive"]},
          "operation": {"type": ["string", "null"]},
          "provider": {"type": ["string", "null"]},
          "modelProfile": {"type": ["string", "null"]},
          "model": {"type": ["string", "null"]},
          "endpointProfile": {"type": ["string", "null"]},
          "credentialRef": {"type": ["string", "null"]},
          "fallbackProfiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "approval": {"type": "string", "enum": ["none", "required"]},
          "outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
