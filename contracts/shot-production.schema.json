{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/shot-production.schema.json",
  "title": "Auto3Dvideo Shot Production",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "shotId", "durationFrames", "storyBeat", "subject", "environment", "camera", "lens", "action", "lighting", "color", "continuity", "referenceAssets", "blenderConstraints", "flowPrompt", "negativePrompt", "acceptanceChecks", "status"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "shotId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "durationFrames": {"type": "integer", "minimum": 1, "maximum": 864000},
    "storyBeat": {"type": "string", "minLength": 3, "maxLength": 1000},
    "subject": {"type": "string", "minLength": 2, "maxLength": 2000},
    "environment": {"type": "string", "minLength": 2, "maxLength": 2000},
    "camera": {"type": "string", "minLength": 2, "maxLength": 1200},
    "lens": {"type": "number", "exclusiveMinimum": 0, "maximum": 500},
    "action": {"type": "string", "minLength": 2, "maxLength": 2000},
    "lighting": {"type": "string", "minLength": 2, "maxLength": 1200},
    "color": {"type": "string", "minLength": 2, "maxLength": 1200},
    "continuity": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 600}, "maxItems": 32},
    "referenceAssets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 64},
    "blenderConstraints": {"type": "array", "items": {"type": "string", "maxLength": 600}, "maxItems": 32},
    "flowPrompt": {"type": "string", "minLength": 3, "maxLength": 5000},
    "negativePrompt": {"type": "string", "maxLength": 3000},
    "acceptanceChecks": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 600}, "maxItems": 32},
    "voiceSegmentIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 64},
    "status": {"type": "string", "enum": ["planned", "ready", "queued", "generating", "generated", "needs_review", "approved", "rejected", "blocked"]}
  }
}
