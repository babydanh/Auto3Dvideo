{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/worker-plan.schema.json",
  "title": "Auto3Dvideo Worker Plan",
  "description": "Deterministic stage and attempt plan. It is evidence-only and contains no shell command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "workflowId", "profile", "dryRun", "processesStarted", "networkCallsMade", "externalPublish", "paidGeneration", "stages"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "planId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "workflowId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "profile": {"type": "string", "enum": ["mock", "local", "hybrid", "cloud"]},
    "dryRun": {"type": "boolean", "const": true},
    "processesStarted": {"type": "boolean", "const": false},
    "networkCallsMade": {"type": "boolean", "const": false},
    "externalPublish": {"type": "boolean", "const": false},
    "paidGeneration": {"type": "boolean", "const": false},
    "maxAttemptsPerStage": {"type": "integer", "minimum": 1, "maximum": 10},
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stageId", "stageType", "dependsOn", "executor", "resourceClass", "outputs", "attempt"],
        "properties": {
          "stageId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
          "stageType": {"type": "string", "minLength": 1, "maxLength": 128},
          "dependsOn": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"}, "uniqueItems": true},
          "executor": {"type": "string", "enum": ["mock", "comfyui", "blender", "ffmpeg", "provider_adapter", "interactive"]},
          "executableId": {"type": ["string", "null"], "enum": ["blender", "ffmpeg", "ffprobe", "node", "obs", "python", null]},
          "operation": {"type": ["string", "null"], "maxLength": 128},
          "resourceClass": {"type": "string", "enum": ["cpu", "cpu_heavy", "gpu", "io_heavy", "network", "paid_api", "interactive"]},
          "approvalRequired": {"type": "boolean"},
          "outputs": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
          "attempt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attemptId", "attemptNumber", "state", "timeoutSeconds", "processStarted", "externalSideEffectUnknown"],
            "properties": {
              "attemptId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
              "attemptNumber": {"type": "integer", "const": 1},
              "state": {"type": "string", "const": "pending"},
              "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 604800},
              "processStarted": {"type": "boolean", "const": false},
              "externalSideEffectUnknown": {"type": "boolean", "const": false}
            }
          }
        }
      }
    }
  }
}
