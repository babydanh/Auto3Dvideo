{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/nanobanana-image-job.schema.json",
  "title": "Auto3Dvideo Nano Banana MCP Image Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobType", "provider", "mode", "projectId", "runId", "serverEntry", "flowCdpUrl", "toolName", "outputDirectory", "tasks"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "jobType": {"type": "string", "const": "image.generate"},
    "provider": {"type": "string", "const": "nano_banana_mcp"},
    "mode": {"type": "string", "const": "flow_browser"},
    "projectId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "serverEntry": {"type": "string", "minLength": 1},
    "flowCdpUrl": {"type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost):[1-9][0-9]{0,4}$"},
    "toolName": {"type": "string", "const": "generate_image"},
    "model": {"type": "string", "maxLength": 120},
    "outputDirectory": {"type": "string", "minLength": 1},
    "timeoutSeconds": {"type": "integer", "minimum": 30, "maximum": 3600},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "shotId", "title", "prompt", "width", "height", "role", "rightsStatus"],
        "properties": {
          "assetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "shotId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "prompt": {"type": "string", "minLength": 3, "maxLength": 12000},
          "negativePrompt": {"type": "string", "maxLength": 8000},
          "width": {"type": "integer", "minimum": 64, "maximum": 4096},
          "height": {"type": "integer", "minimum": 64, "maximum": 4096},
          "role": {"type": "string", "enum": ["identity", "composition", "pose", "camera", "style", "environment", "prop"]},
          "rightsStatus": {"type": "string", "enum": ["unknown", "pending", "personal", "owned", "licensed", "public_domain", "restricted", "rejected"]},
          "referenceImages": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
