{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/asset-pack-blender-binding.schema.json",
  "title": "Auto3Dvideo Asset Pack Blender Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bindingId",
    "projectId",
    "packId",
    "status",
    "identityAnchorIds",
    "assetBindings",
    "worldScaleMeters",
    "cameraContinuity",
    "screenDirection",
    "materialPalette",
    "approvedReferenceHashes",
    "blenderJob",
    "humanReviewRequired",
    "blenderExecutionStarted"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "bindingId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,96}$"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "packId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "status": {"type": "string", "enum": ["ready_for_blender_review", "blocked", "needs_review"]},
    "identityAnchorIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"}
    },
    "assetBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bindingId",
          "assetId",
          "assetItemId",
          "shotId",
          "sourceRole",
          "role",
          "sourcePath",
          "assetSha256",
          "referenceKind",
          "identityAnchorId",
          "scaleMeters",
          "continuityAnchors",
          "rightsStatus",
          "reviewState",
          "locked"
        ],
        "properties": {
          "bindingId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,120}$"},
          "assetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "assetItemId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
          "shotId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
          "sourceRole": {"type": "string", "enum": ["identity", "composition", "pose", "camera", "style", "environment", "prop", "scale_reference", "start_frame", "end_frame"]},
          "role": {"type": "string", "enum": ["identity", "composition", "pose", "camera", "style", "texture", "start_frame", "end_frame", "environment", "model3d", "voice_reference"]},
          "sourcePath": {"type": "string", "minLength": 1, "maxLength": 1024},
          "assetSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "referenceKind": {"type": "string", "enum": ["reference_image", "model3d", "texture", "scene"]},
          "identityAnchorId": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
          "scaleMeters": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000},
          "continuityAnchors": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
          "rightsStatus": {"type": "string", "enum": ["personal", "owned", "licensed", "public_domain"]},
          "reviewState": {"type": "string", "const": "approved"},
          "locked": {"type": "boolean", "const": true}
        }
      }
    },
    "worldScaleMeters": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
    "cameraContinuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "requiredViews", "continuityAnchors"],
      "properties": {
        "policy": {"type": "string", "enum": ["preserve_pack_views_and_anchors"]},
        "requiredViews": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "continuityAnchors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
      }
    },
    "screenDirection": {"type": "string", "enum": ["left_to_right", "right_to_left", "unspecified"]},
    "materialPalette": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "approvedReferenceHashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}},
    "blenderJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "jobType", "scenePath", "scriptPath", "outputDirectory", "executionMode", "timeoutSeconds", "allowNetwork", "expectedOutputKind"],
      "properties": {
        "schemaVersion": {"type": "string", "const": "1.0.0"},
        "jobType": {"type": "string", "const": "scene.build"},
        "scenePath": {"type": "string", "minLength": 1},
        "scriptPath": {"type": "string", "minLength": 1},
        "outputDirectory": {"type": "string", "minLength": 1},
        "executionMode": {"type": "string", "enum": ["preview", "final", "inspect"]},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "allowNetwork": {"type": "boolean", "const": false},
        "expectedOutputKind": {"type": "string", "enum": ["none", "image", "image_sequence", "video", "metadata"]}
      }
    },
    "humanReviewRequired": {"type": "boolean", "const": true},
    "blenderExecutionStarted": {"type": "boolean", "const": false}
  }
}
