{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/prompt-preset.schema.json",
  "title": "Auto3Dvideo Prompt Preset",
  "description": "A local, versioned prompt preset owned by a project and safe to reuse across briefs and shots.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "presetId", "projectId", "name", "description", "scope", "status", "version", "template", "variableKeys", "negativeTemplate", "providerTargets", "styleBibleId", "rightsLicenseNote", "parentPresetId", "createdAt", "updatedAt", "archivedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "presetId": { "type": "string", "minLength": 3, "maxLength": 120, "pattern": "^[A-Za-z0-9._-]+$" },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "scope": { "enum": ["project", "user"] },
    "status": { "enum": ["draft", "active", "archived"] },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "template": { "type": "string", "minLength": 1, "maxLength": 16000 },
    "variableKeys": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }, "maxItems": 64, "uniqueItems": true },
    "negativeTemplate": { "type": "string", "maxLength": 8000 },
    "providerTargets": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 120 }, "maxItems": 32, "uniqueItems": true },
    "styleBibleId": { "type": ["string", "null"], "maxLength": 120 },
    "rightsLicenseNote": { "type": "string", "maxLength": 1000 },
    "parentPresetId": { "type": ["string", "null"], "maxLength": 120 },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "archivedAt": { "type": ["string", "null"] }
  }
}
