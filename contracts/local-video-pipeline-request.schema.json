{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/local-video-pipeline-request.schema.json",
  "title": "Auto3Dvideo Local Video Pipeline Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "projectId", "brief", "approvalStatus", "dryRun", "externalPublish"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "requestId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "brief": {"$ref": "video-brief.schema.json"},
    "approvalStatus": {"type": "string", "enum": ["pending", "approved", "rejected"]},
    "dryRun": {"type": "boolean"},
    "externalPublish": {"type": "boolean", "const": false},
    "paidGeneration": {"type": "boolean", "const": false},
    "allowNetwork": {"type": "boolean"},
    "stages": {
      "type": "array",
      "items": {"type": "string", "enum": ["script", "scene", "voice", "captions", "render", "probe", "manifest"]},
      "uniqueItems": true,
      "minItems": 1
    }
  }
}
