{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/media-plan.schema.json",
  "title": "Auto3Dvideo Media Plan",
  "description": "Typed local media operation plan. Application code compiles this plan to FFmpeg/FFprobe arguments; it is never a shell command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "operation", "executableId", "workingDirectory", "inputs", "output", "timeoutSeconds", "dryRun", "externalPublish", "paidGeneration"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "planId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "operation": {"type": "string", "enum": ["probe", "normalize", "concat", "mux", "subtitle", "thumbnail", "variant", "image_sequence", "audio_normalize", "caption_generate"]},
    "executableId": {"type": "string", "enum": ["ffmpeg", "ffprobe"]},
    "workingDirectory": {"type": "string", "minLength": 1, "maxLength": 1024, "description": "Relative path inside the project workspace."},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "kind"],
        "properties": {
          "relativePath": {"type": "string", "minLength": 1, "maxLength": 1024},
          "kind": {"type": "string", "enum": ["video", "audio", "image", "subtitle", "metadata", "image_sequence"]},
          "required": {"type": "boolean", "default": true}
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "kind", "overwritePolicy"],
      "properties": {
        "relativePath": {"type": "string", "minLength": 1, "maxLength": 1024},
        "kind": {"type": "string", "enum": ["video", "audio", "thumbnail", "subtitle", "metadata"]},
        "overwritePolicy": {"type": "string", "enum": ["fail", "versioned"]}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 16, "maximum": 16384},
        "height": {"type": "integer", "minimum": 16, "maximum": 16384},
        "frameRate": {"type": "number", "exclusiveMinimum": 0, "maximum": 240},
        "container": {"type": "string", "enum": ["mp4", "mov", "webm", "mkv", "wav", "mp3", "png", "srt", "vtt", "json"]},
        "videoCodec": {"type": "string", "enum": ["h264", "hevc", "vp9", "av1", "prores", "png"]},
        "audioCodec": {"type": "string", "enum": ["aac", "opus", "pcm_s16le", "mp3"]},
        "audioRequired": {"type": "boolean"},
        "captionMode": {"type": "string", "enum": ["none", "sidecar", "burned"]},
        "captionLocale": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"}
      }
    },
    "expectedDurationSeconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 604800},
    "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "dryRun": {"type": "boolean", "const": true},
    "externalPublish": {"type": "boolean", "const": false},
    "paidGeneration": {"type": "boolean", "const": false}
  }
}
