{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/job.schema.json",
  "title": "Auto3Dvideo Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "projectId", "type", "status", "resourceClass", "idempotencyKey", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "jobId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "episodeId": {"type": ["string", "null"]},
    "shotId": {"type": ["string", "null"]},
    "type": {"type": "string", "enum": ["brief.normalize", "script.draft", "style.define", "shots.plan", "references.prepare", "ai.generate", "asset.ingest", "scene.build", "render.preview", "render.final", "media.compose", "caption.generate", "delivery.package", "publish.prepare", "publish"]},
    "status": {"type": "string", "enum": ["draft", "ready", "waiting_approval", "queued", "running", "succeeded", "ingesting", "review_required", "approved", "delivered", "failed", "cancel_requested", "cancelled", "blocked", "expired", "skipped"]},
    "resourceClass": {"type": "string", "enum": ["cpu", "cpu_heavy", "gpu", "io_heavy", "network", "paid_api", "interactive"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "dependencyIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inputRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 300},
    "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 10},
    "approvalRequired": {"type": "boolean"},
    "estimatedCostUsd": {"type": ["number", "null"], "minimum": 0},
    "actualCostUsd": {"type": ["number", "null"], "minimum": 0},
    "providerJobId": {"type": ["string", "null"]},
    "outputAssetIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "errorCode": {"type": ["string", "null"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
