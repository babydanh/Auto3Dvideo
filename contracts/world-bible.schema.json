{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/world-bible.schema.json",
  "title": "Auto3Dvideo World Bible",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bibleId", "name", "era", "scaleSystem", "environment", "palette", "continuityRules", "negativeConstraints"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "bibleId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,96}$"},
    "name": {"type": "string", "minLength": 3, "maxLength": 160},
    "era": {"type": "string", "minLength": 2, "maxLength": 240},
    "scaleSystem": {"type": "string", "enum": ["meters", "centimeters", "custom"]},
    "environment": {"type": "string", "minLength": 3, "maxLength": 2000},
    "palette": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "maxLength": 80}},
    "materials": {"type": "array", "items": {"type": "string", "maxLength": 160}, "maxItems": 32},
    "cameraLanguage": {"type": "string", "maxLength": 2000},
    "lightingLanguage": {"type": "string", "maxLength": 2000},
    "atmosphere": {"type": "string", "maxLength": 1000},
    "continuityRules": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 600}, "maxItems": 32},
    "negativeConstraints": {"type": "array", "items": {"type": "string", "maxLength": 600}, "maxItems": 32},
    "assetIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 128}
  }
}
