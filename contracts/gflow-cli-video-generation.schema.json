{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/gflow-cli-video-generation.schema.json",
  "title": "gflow-cli video generation contract",
  "description": "Request, worker report, and resumable per-shot state used by the pinned gflow-cli provider adapter.",
  "oneOf": [
    { "$ref": "#/$defs/workerRequest" },
    { "$ref": "#/$defs/workerReport" },
    { "$ref": "#/$defs/workerError" },
    { "$ref": "#/$defs/stateDocument" }
  ],
  "$defs": {
    "relativeWorkspacePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "shotInput": {
      "type": "object",
      "required": ["shotId", "revisionId", "prompt", "promptSha256", "durationSeconds", "targetDurationSeconds", "outputRelativePath", "referencePaths"],
      "properties": {
        "projectId": { "type": "string", "minLength": 3, "maxLength": 64 },
        "shotId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$" },
        "revisionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "promptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "integer", "enum": [4, 6, 8, 10] },
        "targetDurationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "outputRelativePath": { "$ref": "#/$defs/relativeWorkspacePath" },
        "referencePaths": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/relativeWorkspacePath" }
        },
        "settings": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "workerRequest": {
      "type": "object",
      "required": ["projectId", "flowProjectId", "profile", "model", "aspect", "stateRelativePath", "ffprobePath", "segments"],
      "properties": {
        "projectId": { "type": "string", "minLength": 3, "maxLength": 64 },
        "flowProjectId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "profile": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model": { "type": "string", "enum": ["veo-fast", "veo-lite", "veo-quality", "veo-lite-lp", "omni-flash"] },
        "aspect": { "type": "string", "enum": ["16:9", "9:16"] },
        "stateRelativePath": { "$ref": "#/$defs/relativeWorkspacePath" },
        "ffprobePath": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/shotInput" }
        }
      },
      "additionalProperties": false
    },
    "workerReport": {
      "type": "object",
      "required": ["status", "flowProjectId", "shots", "stateRelativePath"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "partial", "fail"] },
        "flowProjectId": { "type": "string" },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["shotId", "status", "outputRelativePath"],
            "properties": {
              "shotId": { "type": "string" },
              "status": { "type": "string", "enum": ["validated", "skipped_validated", "blocked_unverified"] },
              "outputRelativePath": { "$ref": "#/$defs/relativeWorkspacePath" },
              "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "message": { "type": "string", "maxLength": 480 }
            },
            "additionalProperties": false
          }
        },
        "stateRelativePath": { "$ref": "#/$defs/relativeWorkspacePath" }
      },
      "additionalProperties": false
    },
    "workerError": {
      "type": "object",
      "required": ["status", "error"],
      "properties": {
        "status": { "const": "fail" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string", "maxLength": 5000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shotState": {
      "type": "object",
      "required": ["status", "shotId", "revisionId", "promptSha256", "inputSha256", "outputRelativePath"],
      "properties": {
        "status": { "type": "string", "enum": ["submitted", "validated", "unknown"] },
        "shotId": { "type": "string" },
        "revisionId": { "type": "string" },
        "promptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "outputRelativePath": { "$ref": "#/$defs/relativeWorkspacePath" },
        "message": { "type": "string", "maxLength": 480 }
      },
      "additionalProperties": false
    },
    "stateDocument": {
      "type": "object",
      "required": ["schemaVersion", "shots"],
      "properties": {
        "schemaVersion": { "const": "1.1.0" },
        "shots": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/shotState" }
        }
      },
      "additionalProperties": false
    }
  }
}
