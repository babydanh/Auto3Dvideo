{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/asset-pack.schema.json",
  "title": "Auto3Dvideo Asset Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "projectId",
    "title",
    "status",
    "bibleVersions",
    "identityAnchors",
    "assetItems",
    "acceptancePolicy",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "packId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {
      "type": "string",
      "enum": ["planned", "validated", "queued", "generating", "ingested", "needs_review", "approved", "blocked", "failed"]
    },
    "bibleVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "world", "style"],
      "properties": {
        "character": {"type": "string", "minLength": 1, "maxLength": 160},
        "world": {"type": "string", "minLength": 1, "maxLength": 160},
        "style": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "identityAnchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"}
    },
    "assetItems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetItemId", "role", "status", "reviewState", "rightsStatus", "outputAssetIds"],
        "properties": {
          "assetItemId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
          "identityAnchorId": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
          "role": {
            "type": "string",
            "enum": ["identity", "composition", "pose", "camera", "style", "environment", "prop", "scale_reference", "start_frame", "end_frame"]
          },
          "status": {
            "type": "string",
            "enum": ["planned", "validated", "queued", "generating", "ingested", "needs_review", "approved", "blocked", "failed", "rejected"]
          },
          "reviewState": {"type": "string", "enum": ["not_started", "in_review", "approved", "rejected", "needs_revision"]},
          "rightsStatus": {"type": "string", "enum": ["unknown", "pending", "personal", "owned", "licensed", "public_domain", "restricted", "rejected"]},
          "outputAssetIds": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 32,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}
          }
        }
      }
    },
    "acceptancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresHumanReview", "requiresApprovedIdentityAnchor", "requiresApprovedRights", "requiredRoles"],
      "properties": {
        "requiresHumanReview": {"type": "boolean", "const": true},
        "requiresApprovedIdentityAnchor": {"type": "boolean", "const": true},
        "requiresApprovedRights": {"type": "boolean", "const": true},
        "requiresScaleReference": {"type": "boolean"},
        "requiredRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["identity", "composition", "pose", "camera", "style", "environment", "prop", "scale_reference", "start_frame", "end_frame"]
          }
        }
      }
    },
    "promptCompilerVersion": {"type": "string", "maxLength": 80},
    "note": {"type": "string", "maxLength": 4000},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
