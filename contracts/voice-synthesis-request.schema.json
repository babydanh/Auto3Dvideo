{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/voice-synthesis-request.schema.json",
  "title": "Auto3Dvideo Voice Synthesis Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "projectId", "voiceProfileId", "modelId", "text", "language", "outputPath", "speed", "qualityPreset", "cloneConsent"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "requestId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "voiceProfileId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "modelId": {"type": "string", "const": "k2-fsa/OmniVoice"},
    "mode": {"type": "string", "enum": ["clone", "design"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 100000},
    "emotionCode": {"type": "string", "enum": ["neutral", "calm", "warm", "friendly", "happy", "excited", "joyful", "triumphant", "sad", "melancholic", "tender", "concerned", "fearful", "angry", "shouting", "urgent", "serious", "surprised", "mysterious", "curious", "sarcastic", "whisper"]},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$", "maxLength": 16},
    "instruct": {"type": ["string", "null"], "maxLength": 1600},
    "referenceAudioPath": {"type": ["string", "null"], "maxLength": 320},
    "referenceTranscript": {"type": ["string", "null"], "maxLength": 2000},
    "outputPath": {"type": "string", "pattern": "^(?!.*(?:^|/)(?:\\.\\.?)(?:/|$))[A-Za-z0-9_./\\-]+\\.wav$", "maxLength": 1024},
    "speed": {"type": "number", "minimum": 0.5, "maximum": 2.0},
    "durationSeconds": {"type": ["number", "null"], "minimum": 0.5, "maximum": 600},
    "qualityPreset": {"type": "string", "enum": ["preview", "balanced", "quality"]},
    "classTemperature": {"type": "number", "minimum": 0, "maximum": 2},
    "positionTemperature": {"type": "number", "minimum": 0, "maximum": 10},
    "normalizeText": {"type": "boolean"},
    "postprocessOutput": {"type": "boolean"},
    "cloneConsent": {"type": "boolean"},
    "networkCallsAllowed": {"type": "boolean", "const": false},
    "idempotencyKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"}
  }
}
