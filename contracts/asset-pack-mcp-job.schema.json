{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/asset-pack-mcp-job.schema.json",
  "title": "Auto3Dvideo Nano Banana Asset Pack MCP Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobType", "provider", "mode", "projectId", "packId", "runId", "serverEntry", "flowCdpUrl", "toolName", "outputDirectory", "tasks"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "jobType": {"type": "string", "const": "asset.pack.generate"},
    "provider": {"type": "string", "const": "nano_banana_mcp"},
    "mode": {"type": "string", "const": "flow_browser"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "packId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "runId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
    "serverEntry": {"type": "string", "minLength": 1, "maxLength": 1000},
    "flowCdpUrl": {"type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost):[1-9][0-9]{0,4}$"},
    "toolName": {"type": "string", "const": "generate_image"},
    "outputDirectory": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.).+"},
    "timeoutSeconds": {"type": "integer", "minimum": 30, "maximum": 3600},
    "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 2},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetItemId", "title", "prompt", "negativePrompt", "width", "height", "role", "rightsStatus", "dependsOn"],
        "properties": {
          "assetItemId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "prompt": {"type": "string", "minLength": 20, "maxLength": 12000},
          "negativePrompt": {"type": "string", "minLength": 10, "maxLength": 8000},
          "width": {"type": "integer", "minimum": 256, "maximum": 8192},
          "height": {"type": "integer", "minimum": 256, "maximum": 8192},
          "role": {"type": "string", "enum": ["identity", "composition", "pose", "camera", "style", "environment", "prop", "scale_reference", "start_frame", "end_frame"]},
          "rightsStatus": {"type": "string", "enum": ["unknown", "pending", "personal", "owned", "licensed", "public_domain", "restricted", "rejected"]},
          "referenceImages": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
          "dependsOn": {"type": "array", "uniqueItems": true, "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"}}
        }
      }
    }
  }
}
