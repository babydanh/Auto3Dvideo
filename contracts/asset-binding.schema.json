{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/asset-binding.schema.json",
  "title": "Auto3Dvideo Asset Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bindingId", "assetId", "shotId", "role", "assetSha256", "rightsStatus", "reviewState"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "bindingId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,96}$"},
    "assetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "shotId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "role": {"type": "string", "enum": ["identity", "composition", "pose", "camera", "style", "texture", "start_frame", "end_frame", "environment", "model3d", "voice_reference"]},
    "assetSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "strength": {"type": "number", "minimum": 0, "maximum": 1},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "provenance": {"type": "string", "maxLength": 2000},
    "rightsStatus": {"type": "string", "enum": ["unknown", "pending", "personal", "owned", "licensed", "public_domain", "restricted", "rejected"]},
    "reviewState": {"type": "string", "enum": ["draft", "needs_review", "approved", "rejected", "blocked"]}
  }
}
