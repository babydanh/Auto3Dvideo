{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto3dvideo.local/contracts/comfyui-job.schema.json",
  "title": "ComfyUI Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowId", "workflowVersion", "endpointMode", "bindings", "expectedOutputs"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "workflowId": {"type": "string", "minLength": 1},
    "workflowVersion": {"type": "string", "minLength": 1},
    "workflowSha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "endpointMode": {"type": "string", "enum": ["local_loopback", "approved_remote"]},
    "endpoint": {"type": "string", "format": "uri"},
    "bindings": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}},
    "referenceAssetIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expectedOutputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "binding"], "properties": {"kind": {"type": "string", "enum": ["image", "video", "audio", "mask", "metadata"]}, "binding": {"type": "string", "minLength": 1}}}},
    "maxRuntimeSeconds": {"type": "integer", "minimum": 1, "maximum": 604800},
    "allowCustomNodes": {"type": "boolean"}
  }
}
