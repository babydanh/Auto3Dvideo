# Auto3Dvideo provider configuration template
# Safe to commit: this file contains no credentials.
# Copy it to a local ignored .env for development. Never commit or attach that file.
# The desktop app reads only AUTO3DVIDEO_* keys, with process environment taking precedence.

AUTO3DVIDEO_ENV=local
AUTO3DVIDEO_PROFILE=mock
AUTO3DVIDEO_DOTENV_PATH=.env
# Use env for local development; use os_credential_store for packaged Windows setup.
AUTO3DVIDEO_SECRET_BACKEND=env
AUTO3DVIDEO_CONFIG_PATH=configs/defaults.yaml
AUTO3DVIDEO_EXTERNAL_PUBLISH=false
AUTO3DVIDEO_REQUIRE_PAID_APPROVAL=true
AUTO3DVIDEO_UNKNOWN_COST_POLICY=block

# Each capability is independent. Select a different provider/model per stage.
# Valid capability blocks: LLM, IMAGE, VIDEO, TTS, STT, AUDIO, ASSET3D, RENDER3D, MEDIA.
# Common fields: ENABLED, PROFILE_ID, PROVIDER, ADAPTER, BASE_URL, MODEL,
# CREDENTIAL_REF, PRICING_MODE, TIMEOUT_SECONDS, MAX_ATTEMPTS, FALLBACK_PROFILES.
# CREDENTIAL_REF must be none, env:UPPERCASE_NAME or os:approved-handle.

# LLM / chat / script planning
AUTO3DVIDEO_LLM_ENABLED=false
AUTO3DVIDEO_LLM_PROFILE_ID=llm_primary
AUTO3DVIDEO_LLM_PROVIDER=ollama_compatible
AUTO3DVIDEO_LLM_ADAPTER=ollama_compatible
AUTO3DVIDEO_LLM_BASE_URL=http://127.0.0.1:11434/v1
AUTO3DVIDEO_LLM_MODEL=replace-with-local-or-approved-model
AUTO3DVIDEO_LLM_API_KEY=
AUTO3DVIDEO_LLM_CREDENTIAL_REF=none
AUTO3DVIDEO_LLM_PRICING_MODE=free_local
AUTO3DVIDEO_LLM_TIMEOUT_SECONDS=300
AUTO3DVIDEO_LLM_MAX_ATTEMPTS=1
AUTO3DVIDEO_LLM_FALLBACK_PROFILES=

# Optional explicit Command Code connectivity probe; general cloud generation remains blocked.
# AUTO3DVIDEO_LLM_ENABLED=true
# AUTO3DVIDEO_LLM_PROVIDER=commandcode
# AUTO3DVIDEO_LLM_ADAPTER=openai_compatible
# AUTO3DVIDEO_LLM_BASE_URL=https://api.commandcode.ai/provider/v1
# AUTO3DVIDEO_LLM_MODEL=poolside/laguna-s-2.1-free
# AUTO3DVIDEO_LLM_CREDENTIAL_REF=env:AUTO3DVIDEO_LLM_API_KEY
# AUTO3DVIDEO_LLM_API_KEY=
# AUTO3DVIDEO_LLM_PRICING_MODE=free_tier
# AUTO3DVIDEO_LLM_TIMEOUT_SECONDS=60
# AUTO3DVIDEO_LLM_MAX_ATTEMPTS=1

# Image / reference generation
AUTO3DVIDEO_IMAGE_ENABLED=false
AUTO3DVIDEO_IMAGE_PROFILE_ID=image_local
AUTO3DVIDEO_IMAGE_PROVIDER=nano_banana
AUTO3DVIDEO_IMAGE_ADAPTER=nano_banana_mcp
AUTO3DVIDEO_IMAGE_BASE_URL=http://127.0.0.1:9222
AUTO3DVIDEO_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Nano Banana Flow MCP: user installs/builds the server separately; no API key is stored here.
AUTO3DVIDEO_NANOBANANA_MCP_SERVER_ENTRY=D:\Auto3DvideoTools\nano-banana-mcp\dist\index.js
AUTO3DVIDEO_NANOBANANA_FLOW_CDP_URL=http://127.0.0.1:9222
AUTO3DVIDEO_NANOBANANA_TOOL=generate_image
# Legacy ComfyUI API-format workflow, used only by the explicit fallback command.
AUTO3DVIDEO_IMAGE_WORKFLOW_PATH=.auto3dvideo/config/comfyui-image-workflow-api.json
AUTO3DVIDEO_IMAGE_API_KEY=
AUTO3DVIDEO_IMAGE_CREDENTIAL_REF=none
AUTO3DVIDEO_IMAGE_PRICING_MODE=subscription
AUTO3DVIDEO_IMAGE_TIMEOUT_SECONDS=900
AUTO3DVIDEO_IMAGE_MAX_ATTEMPTS=1
AUTO3DVIDEO_IMAGE_FALLBACK_PROFILES=

# Video generation: keep disabled until official adapter, pricing, terms and rights are reviewed
AUTO3DVIDEO_VIDEO_ENABLED=false
AUTO3DVIDEO_VIDEO_PROFILE_ID=video_primary
AUTO3DVIDEO_VIDEO_PROVIDER=replace-with-approved-provider
AUTO3DVIDEO_VIDEO_ADAPTER=official_video_api
AUTO3DVIDEO_VIDEO_BASE_URL=https://api.example.com/v1
AUTO3DVIDEO_VIDEO_MODEL=replace-with-approved-video-model
AUTO3DVIDEO_VIDEO_API_KEY=
AUTO3DVIDEO_VIDEO_CREDENTIAL_REF=env:AUTO3DVIDEO_VIDEO_API_KEY
AUTO3DVIDEO_VIDEO_PRICING_MODE=unknown
AUTO3DVIDEO_VIDEO_TIMEOUT_SECONDS=900
AUTO3DVIDEO_VIDEO_MAX_ATTEMPTS=1
AUTO3DVIDEO_VIDEO_FALLBACK_PROFILES=image_local

# Text-to-speech / voice, local-first VieNeu (không cần API key)
AUTO3DVIDEO_TTS_ENABLED=false
AUTO3DVIDEO_TTS_PROFILE_ID=voice_primary
AUTO3DVIDEO_TTS_PROVIDER=vieneu
AUTO3DVIDEO_TTS_ADAPTER=vieneu_local_onnx
AUTO3DVIDEO_TTS_BASE_URL=
AUTO3DVIDEO_TTS_MODEL=pnnbao-ump/VieNeu-TTS-v3-Turbo
AUTO3DVIDEO_TTS_VOICE_ID=Adam
AUTO3DVIDEO_TTS_CREDENTIAL_REF=none
AUTO3DVIDEO_TTS_PRICING_MODE=free_local
AUTO3DVIDEO_TTS_TIMEOUT_SECONDS=1800
AUTO3DVIDEO_TTS_MAX_ATTEMPTS=1
AUTO3DVIDEO_TTS_FALLBACK_PROFILES=
# Optional local OmniVoice Vietnamese dataset; default is D:\\Auto3DvideoTools\\omnivoice-vi
AUTO3DVIDEO_OMNIVOICE_VI_DATASET=

# Speech-to-text / captions, local-first
AUTO3DVIDEO_STT_ENABLED=false
AUTO3DVIDEO_STT_PROFILE_ID=stt_local
AUTO3DVIDEO_STT_PROVIDER=whisper_local
AUTO3DVIDEO_STT_ADAPTER=whisper_local
AUTO3DVIDEO_STT_BASE_URL=
AUTO3DVIDEO_STT_MODEL=replace-with-local-whisper-model
AUTO3DVIDEO_STT_API_KEY=
AUTO3DVIDEO_STT_CREDENTIAL_REF=none
AUTO3DVIDEO_STT_PRICING_MODE=free_local
AUTO3DVIDEO_STT_TIMEOUT_SECONDS=600
AUTO3DVIDEO_STT_MAX_ATTEMPTS=1
AUTO3DVIDEO_STT_FALLBACK_PROFILES=

# Music / audio generation
AUTO3DVIDEO_AUDIO_ENABLED=false
AUTO3DVIDEO_AUDIO_PROFILE_ID=audio_primary
AUTO3DVIDEO_AUDIO_PROVIDER=replace-with-approved-audio-provider
AUTO3DVIDEO_AUDIO_ADAPTER=official_audio_api
AUTO3DVIDEO_AUDIO_BASE_URL=https://api.example.com/v1
AUTO3DVIDEO_AUDIO_MODEL=replace-with-approved-audio-model
AUTO3DVIDEO_AUDIO_API_KEY=
AUTO3DVIDEO_AUDIO_CREDENTIAL_REF=env:AUTO3DVIDEO_AUDIO_API_KEY
AUTO3DVIDEO_AUDIO_PRICING_MODE=unknown
AUTO3DVIDEO_AUDIO_TIMEOUT_SECONDS=600
AUTO3DVIDEO_AUDIO_MAX_ATTEMPTS=1
AUTO3DVIDEO_AUDIO_FALLBACK_PROFILES=

# 3D asset generation / normalization
AUTO3DVIDEO_ASSET3D_ENABLED=false
AUTO3DVIDEO_ASSET3D_PROFILE_ID=asset3d_local
AUTO3DVIDEO_ASSET3D_PROVIDER=local_asset_adapter
AUTO3DVIDEO_ASSET3D_ADAPTER=local_asset_adapter
AUTO3DVIDEO_ASSET3D_BASE_URL=
AUTO3DVIDEO_ASSET3D_MODEL=installed-local-asset-tool
AUTO3DVIDEO_ASSET3D_API_KEY=
AUTO3DVIDEO_ASSET3D_CREDENTIAL_REF=none
AUTO3DVIDEO_ASSET3D_PRICING_MODE=free_local
AUTO3DVIDEO_ASSET3D_TIMEOUT_SECONDS=600
AUTO3DVIDEO_ASSET3D_MAX_ATTEMPTS=1
AUTO3DVIDEO_ASSET3D_FALLBACK_PROFILES=

# Blender / 3D render
AUTO3DVIDEO_RENDER3D_ENABLED=false
AUTO3DVIDEO_RENDER3D_PROFILE_ID=blender_local
AUTO3DVIDEO_RENDER3D_PROVIDER=blender
AUTO3DVIDEO_RENDER3D_ADAPTER=blender
AUTO3DVIDEO_RENDER3D_BASE_URL=
AUTO3DVIDEO_RENDER3D_MODEL=installed-blender
AUTO3DVIDEO_RENDER3D_API_KEY=
AUTO3DVIDEO_RENDER3D_CREDENTIAL_REF=none
AUTO3DVIDEO_RENDER3D_PRICING_MODE=free_local
AUTO3DVIDEO_RENDER3D_TIMEOUT_SECONDS=1800
AUTO3DVIDEO_RENDER3D_MAX_ATTEMPTS=1
AUTO3DVIDEO_RENDER3D_FALLBACK_PROFILES=

# FFmpeg / media compose
AUTO3DVIDEO_MEDIA_ENABLED=true
AUTO3DVIDEO_MEDIA_PROFILE_ID=media_local
AUTO3DVIDEO_MEDIA_PROVIDER=ffmpeg
AUTO3DVIDEO_MEDIA_ADAPTER=ffmpeg
AUTO3DVIDEO_MEDIA_BASE_URL=
AUTO3DVIDEO_MEDIA_MODEL=installed-ffmpeg
AUTO3DVIDEO_MEDIA_API_KEY=
AUTO3DVIDEO_MEDIA_CREDENTIAL_REF=none
AUTO3DVIDEO_MEDIA_PRICING_MODE=free_local
AUTO3DVIDEO_MEDIA_TIMEOUT_SECONDS=600
AUTO3DVIDEO_MEDIA_MAX_ATTEMPTS=1
AUTO3DVIDEO_MEDIA_FALLBACK_PROFILES=

# Important: setting a cloud block to enabled does not submit requests by itself.
# Native execution remains blocked until the provider-specific adapter and approval gates exist.
